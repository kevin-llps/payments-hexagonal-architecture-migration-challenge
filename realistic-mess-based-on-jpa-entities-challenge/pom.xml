<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.7</version>
        <relativePath/>
    </parent>

    <groupId>fr.kevin.llps.payments</groupId>
    <artifactId>realistic-mess-based-on-jpa-entities-challenge</artifactId>
    <version>1.0.0</version>
    <packaging>pom</packaging>
    <name>realistic-mess-based-on-jpa-entities-challenge</name>
    <description>Legacy payments application - realistically messy variant backed by JPA entities</description>

    <modules>
        <module>domain</module>
        <module>client-adapters</module>
        <module>infrastructure-adapters</module>
        <module>bootstrap</module>
    </modules>

    <properties>
        <java.version>21</java.version>
        <archunit.version>1.4.1</archunit.version>
        <!-- Keeps `mvn test -Dtest=X` usable from this directory: modules without a matching test do not fail. -->
        <surefire.failIfNoSpecifiedTests>false</surefire.failIfNoSpecifiedTests>
        <!-- `mvn spring-boot:run` only runs the bootstrap module (it overrides this property). -->
        <spring-boot.run.skip>true</spring-boot.run.skip>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>fr.kevin.llps.payments</groupId>
                <artifactId>domain</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>fr.kevin.llps.payments</groupId>
                <artifactId>client-adapters</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>fr.kevin.llps.payments</groupId>
                <artifactId>infrastructure-adapters</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.tngtech.archunit</groupId>
                <artifactId>archunit-junit5</artifactId>
                <version>${archunit.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>
</project>
