<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.7</version>
        <relativePath/>
    </parent>

    <groupId>fr.kevin.llps.payments</groupId>
    <artifactId>realistic-mess-based-on-jpa-entities-challenge</artifactId>
    <version>1.0.0</version>
    <packaging>pom</packaging>
    <name>realistic-mess-based-on-jpa-entities-challenge</name>
    <description>Legacy payments application - realistically messy variant backed by JPA entities</description>

    <modules>
        <module>domain</module>
        <module>infrastructure-adapters</module>
        <module>client-adapters</module>
        <module>bootstrap</module>
    </modules>

    <properties>
        <java.version>21</java.version>
        <!-- only bootstrap is runnable: keeps `mvn spring-boot:run` working from this directory -->
        <spring-boot.run.skip>true</spring-boot.run.skip>
        <!-- `mvn test -Dtest=X` must not fail in modules that do not contain X -->
        <surefire.failIfNoSpecifiedTests>false</surefire.failIfNoSpecifiedTests>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>fr.kevin.llps.payments</groupId>
                <artifactId>jpa-domain</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>fr.kevin.llps.payments</groupId>
                <artifactId>jpa-infrastructure-adapters</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>fr.kevin.llps.payments</groupId>
                <artifactId>jpa-client-adapters</artifactId>
                <version>${project.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>
</project>
